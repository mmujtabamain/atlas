# OS
.DS_Store

# Rust
/target

# Linux box plumbing (see README.md "Building on the Linux DevBench box"):
# vendored system libraries for a box without root; never part of the product.
/.sysroot

# Headless screenshots produced by scripts/shoot.sh; shared through DevBench media instead.
/shots/*.png
/shots/*.log
/shots/*.mp4
/shots/walkthrough/

# Per-run log files written by the app (see README "Logs and the frame meter").
/logs.log
/logs.prev.log
/shots/logs.log
/shots/logs.prev.log
/crates/*/logs.log
/crates/*/logs.prev.log

# Experiment builds with a different profile (never the product).
/target-opt
